rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != '';
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function adminProfile() {
      return get(adminPath()).data;
    }

    function isAttendiphiAdmin() {
      return isSignedIn()
        && exists(adminPath())
        && adminProfile().isActive != false
        && (adminProfile().role == 'admin' || adminProfile().role == 'superadmin');
    }

    function isSuperAdmin() {
      return isAttendiphiAdmin() && adminProfile().role == 'superadmin';
    }

    function isRegularAdmin() {
      return isAttendiphiAdmin() && adminProfile().role == 'admin';
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Public geofence for QR check-in. Writes: Attendiphi admins only.
    match /locations/{locationId} {
      allow read: if true;
      allow create, update, delete: if isAttendiphiAdmin();
    }

    // Master toggle for check-in restrictions (Thursday / QR date / one-device).
    // Public get so unauthenticated QR clients can stream the flag live.
    // Writes: Super Admin only. Missing doc = clients default to restrictions ON.
    match /appConfig/{configId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSuperAdmin()
        && configId == 'checkInRestrictions'
        && request.resource.data.restrictionsEnabled is bool;
      allow delete: if isSuperAdmin() && configId == 'checkInRestrictions';
    }

    // Public QR create only. Reads/updates/deletes: Attendiphi admins.
    // Phone / member / device uniqueness enforced via session lock docs.
    // GPS / Thursday remain client + lock/transaction helpers (not fully rules-enforceable).
    match /checkIns/{checkInId} {
      allow create: if request.resource.data.keys().hasOnly([
                      'id', 'locationId', 'locationName', 'userName', 'userPhone',
                      'type', 'userLatitude', 'userLongitude', 'gpsAccuracy',
                      'distanceMeters', 'timestamp', 'userEmail',
                      'substituteForMember', 'substituteName', 'companyName',
                      'category', 'invitedByMember', 'photoBase64', 'adminId',
                      'deviceId', 'isVerified', 'verifiedAt', 'verifiedBy',
                      'isEdited', 'editedAt', 'createdAt', 'isFlagged',
                      'flagReason', 'memberId', 'verificationMethod',
                      'faceVerified', 'sessionDate'
                    ])
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() > 0
                    && request.resource.data.userName.size() <= 120
                    && request.resource.data.userPhone is string
                    && request.resource.data.userPhone.size() > 0
                    && request.resource.data.userPhone.size() <= 24
                    && request.resource.data.locationId is string
                    && request.resource.data.locationId.size() > 0
                    && request.resource.data.locationId.size() <= 128
                    && request.resource.data.locationName is string
                    && request.resource.data.locationName.size() <= 200
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 32
                    && (!('photoBase64' in request.resource.data)
                        || (request.resource.data.photoBase64 is string
                            && request.resource.data.photoBase64.size() <= 150000))
                    && (!('sessionDate' in request.resource.data)
                        || (request.resource.data.sessionDate is string
                            && request.resource.data.sessionDate.size() == 10))
                    && !('role' in request.resource.data)
                    && !('isSuperAdmin' in request.resource.data)
                    && !('isAdmin' in request.resource.data)
                    && !('faceEmbedding' in request.resource.data)
                    && !('password' in request.resource.data);
      allow read, update, delete: if isAttendiphiAdmin();
    }

    // One device = one check-in per session date. Public may create-once;
    // document id must be "{deviceId}_{yyyy-MM-dd}". Admins may read/delete.
    match /deviceSessionLocks/{lockId} {
      allow create: if request.resource.data.deviceId is string
                    && request.resource.data.deviceId.size() > 0
                    && request.resource.data.deviceId.size() <= 128
                    && request.resource.data.sessionDate is string
                    && request.resource.data.sessionDate.size() == 10
                    && lockId == request.resource.data.deviceId + '_' + request.resource.data.sessionDate
                    && request.resource.data.keys().hasOnly([
                      'deviceId', 'sessionDate', 'createdAt', 'checkInId'
                    ])
                    && !('role' in request.resource.data)
                    && !('isSuperAdmin' in request.resource.data)
                    && !('isAdmin' in request.resource.data);
      allow get: if true;
      allow list, update: if false;
      allow delete: if isAttendiphiAdmin();
    }

    // One phone = one check-in per session date (always, even when restrictions OFF).
    match /phoneSessionLocks/{lockId} {
      allow create: if request.resource.data.phoneDigits is string
                    && request.resource.data.phoneDigits.size() == 10
                    && request.resource.data.sessionDate is string
                    && request.resource.data.sessionDate.size() == 10
                    && lockId == request.resource.data.phoneDigits + '_' + request.resource.data.sessionDate
                    && request.resource.data.keys().hasOnly([
                      'phoneDigits', 'sessionDate', 'createdAt', 'checkInId'
                    ]);
      allow get: if true;
      allow list, update: if false;
      allow delete: if isAttendiphiAdmin();
    }

    // One member (self or substitute-for) = one check-in per session date.
    match /memberSessionLocks/{lockId} {
      allow create: if request.resource.data.memberId is string
                    && request.resource.data.memberId.size() > 0
                    && request.resource.data.memberId.size() <= 128
                    && request.resource.data.sessionDate is string
                    && request.resource.data.sessionDate.size() == 10
                    && lockId == request.resource.data.memberId + '_' + request.resource.data.sessionDate
                    && request.resource.data.keys().hasOnly([
                      'memberId', 'sessionDate', 'createdAt', 'checkInId'
                    ]);
      allow get: if true;
      allow list, update: if false;
      allow delete: if isAttendiphiAdmin();
    }

    // Public projection for QR typeahead: checked-in member IDs for yyyy-MM-dd.
    match /sessionAttendance/{dateId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.sessionDate == dateId
                    && request.resource.data.checkedInMemberIds is list
                    && request.resource.data.checkedInMemberIds.size() <= 500
                    && request.resource.data.keys().hasOnly([
                      'sessionDate', 'checkedInMemberIds', 'updatedAt'
                    ])
                    && (resource == null
                        || request.resource.data.checkedInMemberIds.size()
                            >= resource.data.checkedInMemberIds.size())
                    && (resource == null
                        || request.resource.data.checkedInMemberIds.size()
                            - resource.data.checkedInMemberIds.size() <= 2);
      allow delete: if isAttendiphiAdmin();
    }

    // Document ID must be the Firebase Auth UID (admins/{uid}).
    match /admins/{adminId} {
      allow get: if isSignedIn() && (
        adminId == request.auth.uid
        || isSuperAdmin()
        || (isRegularAdmin() && (resource == null || resource.data.createdBy == request.auth.uid))
      );
      allow list: if isSuperAdmin()
        || (isRegularAdmin() && resource.data.createdBy == request.auth.uid);

      allow create: if isAttendiphiAdmin()
        && request.resource.data.role == 'admin'
        && request.resource.data.uid == adminId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;

      allow update: if isSignedIn() && (
        (
          adminId == request.auth.uid
          && unchanged('role')
          && unchanged('isActive')
          && unchanged('createdBy')
          && unchanged('uid')
        )
        || (
          isSuperAdmin()
          && unchanged('role')
          && unchanged('createdBy')
          && unchanged('uid')
        )
        || (
          isRegularAdmin()
          && resource.data.createdBy == request.auth.uid
          && resource.data.role == 'admin'
          && request.resource.data.role == 'admin'
          && unchanged('createdBy')
          && unchanged('uid')
        )
      );

      allow delete: if isSuperAdmin()
        || (
          isRegularAdmin()
          && resource.data.createdBy == request.auth.uid
          && resource.data.role == 'admin'
          && adminId != request.auth.uid
        );
    }

    // Public read for QR member dropdown (name/phone). New creates must not
    // ship biometrics here — use faceTemplates (admin-only). Updates may still
    // carry legacy embedding fields until migrated; clients strip on write.
    match /employees/{employeeId} {
      allow read: if true;
      allow create: if isAttendiphiAdmin()
        && !('faceEmbedding' in request.resource.data)
        && !('faceTemplates' in request.resource.data)
        && !('faceDescriptors' in request.resource.data);
      allow update, delete: if isAttendiphiAdmin();
    }

    // Locked biometrics — Attendiphi admins only (not public QR).
    match /faceTemplates/{memberId} {
      allow read, write: if isAttendiphiAdmin();
    }

    match /admin_devices/{tokenId} {
      allow read: if isAttendiphiAdmin() && (
        isSuperAdmin() || resource.data.uid == request.auth.uid
      );
      allow create: if isAttendiphiAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string;
      allow update, delete: if isAttendiphiAdmin()
        && resource.data.uid == request.auth.uid;
    }

    match /admin_notifications/{notificationId} {
      allow read, create, update, delete: if isAttendiphiAdmin();
    }

    match /admin_mail_dispatch/{mailId} {
      allow read, update, delete: if false;
      allow create: if isAttendiphiAdmin()
                    && request.resource.data.status == 'manual_draft'
                    && !('password' in request.resource.data)
                    && !('plainPassword' in request.resource.data)
                    && !('temporaryPassword' in request.resource.data)
                    && !('adminPassword' in request.resource.data)
                    && !('credentials' in request.resource.data);
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /admin_password_resets/{resetId} {
      allow read, write: if false;
    }

    match /admin_password_reset_rate/{adminId} {
      allow read, write: if false;
    }
  }
}
