rules_version = '2';

// Attendiphi does not use Firebase Storage in the Flutter client
// (substitute photos are stored as Firestore photoBase64).
// Deny all Storage access by default so enabling Storage in Console
// cannot accidentally leave an open bucket.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
